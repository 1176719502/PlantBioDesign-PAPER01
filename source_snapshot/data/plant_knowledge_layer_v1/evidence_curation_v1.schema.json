{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plant Knowledge Layer v1 expanded evidence curation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "registry_source", "records"],
  "properties": {
    "schema_version": {"const": "plant-knowledge-layer-evidence-v1"},
    "dataset_version": {"type": "string", "minLength": 1},
    "registry_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_path", "registry_version", "source_manifest_path"],
      "properties": {
        "registry_path": {"type": "string", "minLength": 1},
        "registry_version": {"type": "string", "minLength": 1},
        "source_manifest_path": {"type": "string", "minLength": 1}
      }
    },
    "records": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "UNKNOWN"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "accession", "accession_version", "sequence_length", "sequence_sha256", "source_record", "source_record_sha256"],
      "properties": {
        "component_id": {"type": "string", "pattern": "^PCLV1-[A-Z0-9-]+$"},
        "accession": {"type": "string", "minLength": 1},
        "accession_version": {"type": "string", "minLength": 1},
        "sequence_length": {"type": "integer", "minimum": 1},
        "sequence_sha256": {"$ref": "#/$defs/hash"},
        "source_record": {"type": "string", "minLength": 1},
        "source_record_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "literature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "status", "citation", "provenance_note", "source_database", "doi", "pmid"],
      "properties": {
        "reference_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["RECORDED", "UNKNOWN", "PENDING_HUMAN_REVIEW"]},
        "citation": {"type": ["string", "null"]},
        "provenance_note": {"type": "string", "minLength": 1},
        "source_database": {"type": "string", "minLength": 1},
        "doi": {"type": ["string", "null"]},
        "pmid": {"type": ["string", "null"]}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "statement", "fact_status", "provenance", "review_status", "unknown_reason", "evidence_level"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_type": {"enum": ["IDENTITY", "BOUNDARY", "BIOLOGICAL_CONTEXT", "ENGINEERING_CONTEXT", "FUNCTION"]},
        "statement": {"type": "string", "minLength": 1},
        "fact_status": {"enum": ["RECORDED_FROM_REGISTRY", "UNKNOWN", "PENDING_HUMAN_REVIEW"]},
        "provenance": {"type": "string", "minLength": 1},
        "review_status": {"enum": ["PENDING_HUMAN_REVIEW", "DRAFT"]},
        "unknown_reason": {"type": "string", "minLength": 1},
        "evidence_level": {"enum": ["E1", "E2", "UNKNOWN"]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_object_id", "component_id", "display_name", "component_type", "registry_reference", "literature_references", "biological_context", "evidence_claims", "engineering_context_notes", "limitations", "review"],
      "properties": {
        "evidence_object_id": {"type": "string", "pattern": "^PKL1-EV-[A-Z0-9-]+$"},
        "component_id": {"type": "string", "pattern": "^PCLV1-[A-Z0-9-]+$"},
        "display_name": {"type": "string", "minLength": 1},
        "component_type": {"type": "string", "minLength": 1},
        "registry_reference": {"$ref": "#/$defs/registry_ref"},
        "literature_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/literature"}},
        "biological_context": {"type": "object", "minProperties": 1},
        "evidence_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "engineering_context_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_status", "human_review_status", "reviewer", "reviewed_at_utc", "review_notes"],
          "properties": {
            "record_status": {"const": "DRAFT"},
            "human_review_status": {"const": "PENDING_HUMAN_REVIEW"},
            "reviewer": {"type": ["string", "null"]},
            "reviewed_at_utc": {"type": ["string", "null"]},
            "review_notes": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
