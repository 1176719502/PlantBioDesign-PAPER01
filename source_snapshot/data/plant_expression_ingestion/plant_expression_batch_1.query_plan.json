      "query_id": "plant_expression_vector",
      "description": "Plant expression vector literature and protein/accession metadata.",
      "domain_label": "plant expression vector",
      "enabled": true,
      "max_records": 350,
      "date_version": "2026-07-10",
      "notes": "Broad expression-vector metadata candidate query.",
      "source_queries": {
        "europe_pmc": {
          "query": "(TITLE:\"plant expression vector\" OR ABSTRACT:\"plant expression vector\") AND (plant OR plants)",
          "result_type": "core"
        },
        "uniprot": {
          "query": "(taxonomy_id:33090) AND (keyword:Plasmid OR keyword:Expression)"
        }
      }
    },
