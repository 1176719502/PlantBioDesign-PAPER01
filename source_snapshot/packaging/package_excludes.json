{
  "manifest_version": 1,
  "target": "windows-x64-cpython312",
  "excludes": [
    {"pattern": ".git/**", "category": "repository_metadata", "reason": "not application content"},
    {"pattern": ".venv312/**", "category": "development_environment", "reason": "not the reproducible packaged runtime"},
    {"pattern": ".codex/**", "category": "agent_metadata", "reason": "not application content"},
    {"pattern": "tests/**", "category": "test_source", "reason": "tests run outside the artifact"},
    {"pattern": "audit_reports/**", "category": "internal_audit", "reason": "not runtime content"},
    {"pattern": "docs/**", "category": "development_documentation", "reason": "no separately approved user help in this batch"},
    {"pattern": "archive/**", "category": "historical_content", "reason": "not formal runtime content"},
    {"pattern": "archive_v1_dormant/**", "category": "historical_content", "reason": "not formal runtime content"},
    {"pattern": "CURRENT_TASK.md", "category": "agent_task_state", "reason": "not application content"},
    {"pattern": ".streamlit/secrets.toml", "category": "secret", "reason": "must never ship"},
    {"pattern": "data/*.db", "category": "repository_database", "reason": "fresh V10000 database is code-created under LocalAppData"},
    {"pattern": "data/*.sqlite", "category": "repository_database", "reason": "legacy repository SQLite files are excluded; only the exact versioned KB sqlite3 resource is approved"},
    {"pattern": "data/biodesign_unified.*", "category": "user_database", "reason": "the mutable unified database is never distributed"},
    {"pattern": "data/plant_expression_candidates.*", "category": "candidate_database", "reason": "candidate ingestion data is not an approved knowledge release"},
    {"pattern": "plant_expression_knowledge/**", "category": "candidate_data", "reason": "candidate source bundles and snapshots are user data"},
    {"pattern": ".plant_expression_knowledge/**", "category": "candidate_data", "reason": "candidate source bundles and snapshots are user data"},
    {"pattern": "**/*-wal", "category": "database_sidecar", "reason": "SQLite WAL sidecars are mutable runtime artifacts"},
    {"pattern": "**/*-shm", "category": "database_sidecar", "reason": "SQLite SHM sidecars are mutable runtime artifacts"},
    {"pattern": "**/*.backup", "category": "database_backup", "reason": "database backups are user-owned recovery data"},
    {"pattern": "**/*.bak", "category": "database_backup", "reason": "backup files are not formal resources"},
    {"pattern": "**/*.tmp", "category": "temporary", "reason": "temporary build files are never package inputs"},
    {"pattern": "plant_design_project_drafts/**", "category": "user_project_data", "reason": "user-owned JSON remains outside installation"},
    {"pattern": "logs/**", "category": "mutable_runtime", "reason": "belongs under LocalAppData"},
    {"pattern": ".runtime/**", "category": "mutable_runtime", "reason": "belongs under LocalAppData"},
    {"pattern": "runtime/**", "category": "mutable_runtime", "reason": "belongs under LocalAppData"},
    {"pattern": "cache/**", "category": "mutable_runtime", "reason": "recreatable user cache"},
    {"pattern": "temp/**", "category": "temporary", "reason": "machine-specific content"},
    {"pattern": "tmp/**", "category": "temporary", "reason": "machine-specific content"},
    {"pattern": "backups/**", "category": "user_recovery_data", "reason": "user-owned content"},
    {"pattern": ".pytest_cache/**", "category": "test_cache", "reason": "test-only content"},
    {"pattern": ".pytest_tmp/**", "category": "test_cache", "reason": "test-only content"},
    {"pattern": "playwright/**", "category": "browser_artifact", "reason": "Chromium acceptance is external"},
    {"pattern": "node_modules/**", "category": "development_dependency", "reason": "not formal runtime"},
    {"pattern": "coverage.*", "category": "coverage_artifact", "reason": "test-only content"},
    {"pattern": "htmlcov/**", "category": "coverage_artifact", "reason": "test-only content"},
    {"pattern": "build/**", "category": "generated_artifact", "reason": "never an input"},
    {"pattern": "dist/**", "category": "generated_artifact", "reason": "never an input"},
    {"pattern": "frontend/**", "category": "historical_ui", "reason": "not the formal app.py workflow"},
    {"pattern": "prototypes/**", "category": "historical_ui", "reason": "not the formal app.py workflow"},
    {"pattern": "views/legacy_ui_registry.py", "category": "historical_ui", "reason": "P0-B1 found no formal call"},
    {"pattern": "views/Data.py", "category": "historical_ui", "reason": "historical openpyxl page is outside the four formal pages"},
    {"pattern": "examples/plant_single_gene_mvp/**", "category": "unverified_r229_example", "reason": "r229 remains a development compatibility example, not a formal release resource"},
    {"pattern": "core/ai_models.py", "category": "historical_dependency_stack", "reason": "scikit-learn path is not formal-reachable"},
    {"pattern": "services/primer_queue.py", "category": "historical_dependency_stack", "reason": "Redis/RQ queue is not formal-reachable"},
    {"pattern": "services/validation_queue.py", "category": "historical_dependency_stack", "reason": "Redis/RQ queue is not formal-reachable"},
    {"pattern": "scripts/dev/api_primer.py", "category": "development_service", "reason": "FastAPI/Uvicorn path is not formal runtime"},
    {"pattern": "pydna", "category": "optional_dependency", "reason": "excluded from V1 base runtime"},
    {"pattern": "primer3", "category": "optional_dependency", "reason": "native backend disabled and excluded from V1 base runtime"},
    {"pattern": "other_worktrees/**", "category": "external_repository_content", "reason": "resource fallback is forbidden"}
  ],
  "forbidden_distributions": [
    "pydna", "primer3", "primer3-py", "matplotlib-venn", "plotly", "seaborn",
    "openpyxl", "reportlab", "fastapi", "uvicorn", "redis", "rq",
    "scikit-learn", "pytest", "playwright"
  ]
}
