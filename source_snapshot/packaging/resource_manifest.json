    "utils/__init__.py", "utils/logger.py", "views/CrisprWorkspace.py", "views/SequenceToolbox.py", "views/formal_construct_findings.py", "views/wizard_steps/__init__.py", "views/wizard_steps/_shared.py"
  ],
  "python_package_data": [
    {"source": "streamlit:static/**", "destination": "streamlit/static", "kind": "package_data", "required": true, "read_only": true, "missing_behavior": "fail packaged UI startup", "validation": "audited hook inventory and five-page smoke"},
    {"source": "matplotlib:mpl-data/**", "destination": "matplotlib/mpl-data", "kind": "package_data", "required": true, "read_only": true, "missing_behavior": "fail render smoke", "validation": "Matplotlib data-path and font smoke"},
    {"source": "certifi:cacert.pem", "destination": "certifi/cacert.pem", "kind": "package_data", "required": true, "read_only": true, "missing_behavior": "fail HTTPS certificate setup", "validation": "certifi.where points to bundled file"},
    {"source": "pytz:zoneinfo/**", "destination": "pytz/zoneinfo", "kind": "package_data", "required": true, "read_only": true, "missing_behavior": "fail timezone smoke", "validation": "pandas timezone case"},
    {"source": "tzdata:zoneinfo/**", "destination": "tzdata/zoneinfo", "kind": "package_data", "required": true, "read_only": true, "missing_behavior": "fail Windows timezone smoke", "validation": "zoneinfo lookup"},
    {"source": "numpy:native-and-data", "destination": "numpy", "kind": "package_binaries_and_data", "required": true, "read_only": true, "missing_behavior": "fail NumPy import", "validation": "audited hook and DLL inventory"},
