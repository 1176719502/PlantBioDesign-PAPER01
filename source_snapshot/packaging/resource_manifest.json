    {"source": ".streamlit/config.toml", "destination": ".streamlit/config.toml", "kind": "streamlit_config", "required": true, "read_only": true, "missing_behavior": "fail packaging validation", "validation": "explicit file only; never collect .streamlit by wildcard"},
    {"source": "data/real_cases/betalain_three_enzyme", "destination": "data/real_cases/betalain_three_enzyme", "kind": "resource_tree", "required": true, "read_only": true, "missing_behavior": "disable the Gate 3 example and report the missing path", "validation": "source records, extracted FASTA, and provenance JSON exist"},
    {"source": "data/real_assets/pbi121", "destination": "data/real_assets/pbi121", "kind": "resource_tree", "required": true, "read_only": true, "missing_behavior": "disable the pBI121 path and report the missing path", "validation": "GenBank, provenance, feature audit, and verification JSON exist"},
