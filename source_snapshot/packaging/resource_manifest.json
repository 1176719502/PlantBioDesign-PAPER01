    {"source": "data/local_design_asset_seed.json", "destination": "data/local_design_asset_seed.json", "kind": "json_seed", "required": true, "read_only": true, "missing_behavior": "fail local design catalog initialization with named path", "validation": "UTF-8 JSON parses"},
    {"source": "data/vector_asset_contracts_v1/contracts.json", "destination": "data/vector_asset_contracts_v1/contracts.json", "kind": "vector_asset_contract", "required": true, "read_only": true, "missing_behavior": "disable vector-asset admission with named path", "validation": "JSON parses and vector-asset contract regressions pass"},
    {"source": "data/vector_asset_contracts_v1/contracts.schema.json", "destination": "data/vector_asset_contracts_v1/contracts.schema.json", "kind": "vector_asset_contract_schema", "required": true, "read_only": true, "missing_behavior": "fail vector-asset contract validation", "validation": "JSON parses"},
    {"source": "data/plant_component_registry_v1", "destination": "data/plant_component_registry_v1", "kind": "resource_tree", "required": true, "read_only": true, "missing_behavior": "disable registry-backed component library with named path", "validation": "Registry JSON/schema/FASTA and source-record byte hashes validate"},
    {"source": "data/component_library_v2_qualified_core_r2", "destination": "data/component_library_v2_qualified_core_r2", "kind": "component_library_v2_resource_tree", "required": true, "read_only": true, "missing_behavior": "disable Agent component governance with named path", "validation": "reviewed V2 canonical, direct-use, assisted, migration, and blocked JSON records parse"},
    {"source": "data/knowledge_base_v0/kb_v0.sqlite3", "destination": "data/knowledge_base_v0/kb_v0.sqlite3", "kind": "versioned_read_only_knowledge_database", "required": true, "read_only": true, "missing_behavior": "disable only knowledge-backed retrieval with the named resource path", "validation": "manifest SHA-256, size, application_id, user_version, human-approved release, integrity_check, and foreign_key_check validate"},
    {"source": "data/knowledge_base_v0/manifest.json", "destination": "data/knowledge_base_v0/manifest.json", "kind": "knowledge_database_release_manifest", "required": true, "read_only": true, "missing_behavior": "disable only knowledge-backed retrieval with the named manifest path", "validation": "UTF-8 JSON parses and names the exact packaged database resource"},
    {"source": "packaging/application_version.json", "destination": "application_version.json", "kind": "version_metadata", "required": true, "read_only": true, "missing_behavior": "fail packaging validation", "validation": "UTF-8 JSON parses and target matches manifest"},
    {"source": "LICENSE", "destination": "LICENSE", "kind": "project_license", "required": true, "read_only": true, "missing_behavior": "fail release inventory", "validation": "explicit file exists"},
    {"source": "THIRD_PARTY_NOTICES.md", "destination": "THIRD_PARTY_NOTICES.md", "kind": "third_party_notices", "required": true, "read_only": true, "missing_behavior": "fail license gate", "validation": "all direct dependencies are listed"},
    {"source": "packaging/license_inventory.csv", "destination": "license_inventory.csv", "kind": "license_inventory", "required": true, "read_only": true, "missing_behavior": "fail license gate", "validation": "every locked distribution is covered"}
